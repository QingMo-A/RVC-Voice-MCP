PORT=8788
PUBLIC_BASE_URL=http://127.0.0.1:8788
HTTP_TOKEN=replace-with-a-long-random-token
# Leave these empty to use local/Applio and auto-detect one model pair in local/models.
APPLIO_DIR=
PYTHON_PATH=
RVC_MODEL_PATH=
RVC_INDEX_PATH=
OUTPUT_DIR=
TTS_VOICE=zh-CN-YunxiNeural
MAX_TEXT_LENGTH=1200
# widget, local, or both. LOCAL_PLAYER_PATH is optional on Windows.
PLAYBACK_MODE=widget
LOCAL_PLAYER_PATH=
